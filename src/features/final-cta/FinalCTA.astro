---
import "./final-cta.css";
// import Form from "./components/FormNewsletter.astro";
import Form from "./components/ButtonsKickstarter.astro";
---

<section class="cta container-global" id="cta">
  <div class="cta-container">
    <!-- TEXTO -->
    <div class="cta-text reveal">
      <h3 class="text-h3">
        <!-- v1 -->
          <!-- Don't miss the drop. -->
        <!-------------------------->
        <!-- v2: 12/May -->
        We're live on Kickstarter
      </h3>

      <p class="text-description">
        <!-- v1 -->
          <!-- Our best offers vanish in the first 48 hours. Sign up to get notified
          the second we go live and secure your spot at the front of the line. -->
        <!-------------------------->
        <!-- v2: 12/May -->        
        Our Super Early Bird and Early Bird prices are only available for limited units. Don't miss out!
      </p>
    </div>

    <Form />

  </div>
</section>

<script src="./final-cta-reveal.js"></script>

<style scoped>
  /* ========================= */
  /* 📱 MOBILE */
  /* ========================= */

  @media (max-width: 768px) {
    .container-form {
      width: 100%;
    }
    .cta-container {
      flex-direction: column;
      align-items: flex-start;
    }
    .cta-container .cta-text,
    .cta-container .cta-form {
      width: 100%;
    }
    .cta-text h3 {
      font-size: 36px;
    }
    .cta-text p {
      font-size: 16px;
      margin-bottom: 15px;
    }
  }
</style>
